{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "limit": { "context": 1000000, "output": 384000 },
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google Gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash",
          "limit": { "context": 1000000, "output": 65536 },
          "cost": { "input": 0.3, "output": 2.5, "cache_read": 0.075, "cache_write": 0 },
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash-Lite",
          "limit": { "context": 1000000, "output": 65536 },
          "cost": { "input": 0.1, "output": 0.4, "cache_read": 0.025, "cache_write": 0 },
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "model": "deepseek/deepseek-flash",
  "compaction": { "auto": true, "prune": true, "tail_turns": 20 },
  "plugin": [ "jev-guard" ],
  "skills": [ "/opt/jev-review/skills" ],
  "mcp": {
    "servers": {
      "jev-review": {
        "type": "local",
        "command": [ "node", "/opt/jev-review/dist/server.js" ],
        "environment": { "JEV_API_KEY": "{env:JEV_API_KEY}" }
      }
    }
  }
}
