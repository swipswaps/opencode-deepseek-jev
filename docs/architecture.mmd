%% opencode-deepseek-jev request path + deployment (renders natively on GitHub)
flowchart TD
    subgraph client["Client (any node)"]
        B[Browser / opencode TUI]
    end
    subgraph edge["Edge (.24 host)"]
        C[Caddy :4096/:5099<br/>TLS + Basic opencode]
    end
    subgraph svc["Services (compose)"]
        W[opencode-web :4096<br/>53 repo-project sessions]
        D[dashboard :5099<br/>78 sessions, findings]
