#!/usr/bin/env bash
#
# patch-ls-2devnull.sh
#
# Remove the pattern `VAR=$(ls -t "$DIR"/* 2>/dev/null | head -1)` from
# every one-shot script. Rule #8 forbids error suppression. The
# replacement is pure POSIX shell: no external commands, no redirects.
#
# Idempotent. Backs up each file it changes. Syntax-checks and rolls
# back on failure.
#
set -o pipefail

resolve_repo() {
    local c="$1"
    while [ "$c" != "/" ]; do
        if [ -f "$c/opencode.json" ] && [ -f "$c/docker/Dockerfile" ]; then
            printf '%s' "$c"; return 0
        fi
        c=$(dirname "$c")
    done
    return 1
}

main() {
    local script_dir repo ts
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo=$(resolve_repo "$script_dir")
    [ -z "$repo" ] && repo=$(resolve_repo "$PWD")
    [ -z "$repo" ] && { printf 'GATE FAIL: cannot resolve repo\n'; return 2; }
    ts=$(date -u +%Y%m%dT%H%M%SZ)

    printf '=== patch-ls-2devnull.sh ===\n'
    printf 'repo: %s\n' "$repo"
    printf 'ts:   %s\n\n' "$ts"

    local targets="$repo/scripts/archive/one-shot"
    [ -d "$targets" ] || { printf 'GATE FAIL: %s missing\n' "$targets"; return 1; }

    local changed=0 scanned=0 f
    for f in "$targets"/*.sh; do
        [ -f "$f" ] || continue
        scanned=$((scanned + 1))
        python3 - "$f" "$ts" <<'PY'
import re, sys
path, ts = sys.argv[1], sys.argv[2]
with open(path) as fh:
    src = fh.read()

pat = re.compile(r'(\w+)=\$\(ls -t ("[^"]+"|\S+)\/\* 2>\/dev\/null \| head -1\)')

def repl(m):
    var = m.group(1)
    dirv = m.group(2)
    return (
        f'{var}=""; for _f in {dirv}/*; do '
        f'[ -f "$_f" ] || continue; '
        f'if [ -z "${var}" ] || [ "$_f" -nt "${var}" ]; then '
        f'{var}="$_f"; fi; done'
    )

new, n = pat.subn(repl, src)
if n == 0:
    sys.exit(1)

with open(path + ".bak." + ts, "w") as fh:
    fh.write(src)
with open(path, "w") as fh:
    fh.write(new)
print(f"  {path}: {n} replacement(s)")
sys.exit(0)
PY
        if [ $? -eq 0 ]; then
            changed=$((changed + 1))
        fi
    done

    printf '\nscanned: %d files\n' "$scanned"
    printf 'changed: %d files\n' "$changed"

    printf '\nsyntax check and rollback on failure:\n'
    for f in "$targets"/*.sh; do
        [ -f "$f" ] || continue
        [ -f "$f.bak.${ts}" ] || continue
        if bash -n "$f" 2>&1; then
            printf '  OK    %s\n' "$(basename "$f")"
        else
            printf '  FAIL  %s -- restoring from backup\n' "$(basename "$f")"
            cp "$f.bak.${ts}" "$f"
        fi
    done
    return 0
}

main "$@"
