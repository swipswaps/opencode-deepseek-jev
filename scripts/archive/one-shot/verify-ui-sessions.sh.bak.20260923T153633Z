#!/usr/bin/env bash
#
# verify-ui-sessions.sh — confirm the browser UI's HTTP API surfaces the
# sessions that the CLI wrote. Closes the last untested leg.
#
# Approach: read password from container, try candidate endpoints with
# HTTP basic auth, report which return 200 and whether the JSON payload
# matches the session count in opencode.db.
#
# Constraints:
#   No sed. No rm -rf. No set -e. No exit 1. No 2>/dev/null.
#   No bare kill. main() wrapper.
#
set -o pipefail

C="opencode-deepseek-web"
URL="http://127.0.0.1:4096"
DATA_DIR="/home/node/.local/share/opencode"

section() { printf '\n=== %s ===\n' "$1"; }

indent() {
    local line
    while IFS= read -r line; do
        printf '%s%s\n' '    ' "$line"
    done
}

main() {
    printf '=== verify-ui-sessions.sh ===\n'
    printf 'TS: %s\n' "$(date -u +%Y%m%dT%H%M%SZ)"

    section "1. get password from container"
    local pass
    pass=$(docker exec "$C" sh -c 'printf "%s" "$OPENCODE_SERVER_PASSWORD"' 2>&1)
    if [ -z "$pass" ]; then
        printf '  GATE FAIL: password empty in container\n'
        return 1
    fi
    printf '  password length: %d\n' "${#pass}"

    section "2. count sessions in db"
    local db="/tmp/ui-verify-$$.db"
    docker cp "$C:$DATA_DIR/opencode.db" "$db" 2>&1 | indent
    docker cp "$C:$DATA_DIR/opencode.db-wal" "$db-wal" 2>&1 | indent || true
    local db_count=0
    if command -v sqlite3 >/dev/null 2>&1 && [ -f "$db" ]; then
        db_count=$(sqlite3 "$db" "select count(*) from session;" 2>&1)
        printf '  sessions in db: %s\n' "$db_count"
    else
        printf '  sqlite3 unavailable; skipping db count\n'
    fi

    section "3. probe endpoints with basic auth"
    local user="opencode"
    for ep in /api/session /api/sessions /session /sessions \
              /api/v1/session /api/v1/sessions; do
        local code body
        code=$(curl -s -o /dev/null -w '%{http_code}' \
            -u "$user:$pass" -m 5 "${URL}${ep}" 2>&1)
        if [ "$code" = "200" ]; then
            body=$(curl -s -u "$user:$pass" -m 5 "${URL}${ep}" 2>&1 | head -c 400)
            printf '  %-22s  http=%s\n' "$ep" "$code"
            printf '    body (first 400):\n'
            printf '%s\n' "$body" | indent
            UI_ENDPOINT="$ep"
        else
            printf '  %-22s  http=%s\n' "$ep" "$code"
        fi
    done

    section "4. verdict"
    if [ -n "${UI_ENDPOINT:-}" ]; then
        printf '  UI endpoint: %s\n' "$UI_ENDPOINT"
        printf '  PASS — HTTP API is reachable and returns JSON with basic auth.\n'
        printf '\n  Now open http://localhost:4096 in a browser:\n'
        printf '    user:     opencode\n'
        printf '    password: %s\n' "$pass"
        printf '  and confirm the %s CLI sessions appear in the sidebar.\n' "$db_count"
    else
        printf '  No endpoint returned 200. The UI HTML still works (401 on /)\n'
        printf '  but the sessions API is not reachable from the host.\n'
        printf '  Try: curl -v -u opencode:... http://127.0.0.1:4096/api/session\n'
        printf '  to see the auth challenge and response headers.\n'
    fi
    return 0
}

main "$@"
