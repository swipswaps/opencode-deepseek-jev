#!/usr/bin/env bash
#
# fix-data-persistence-v4.1.sh
#
# v4 gated correctly but had a subshell bug: count_sessions set R_BODY
# inside a $(...) capture, so the assignment was lost. v4.1 writes the
# API body to a temp file and reads it back — no shared state through
# subshells.
#
# Single source of truth: `docker inspect .Mounts`.
#
# Contract:
#   R1  Print raw compose block and current .Mounts.
#   R2  If .Mounts contains the data dir → skip rewrite. Else rewrite.
#   R3  Recreate. Re-inspect. Abort before persistence test if still missing.
#   R4  Only if .Mounts confirms → run persistence test.
#   R5  Every API call prints its body from a file next to its count.
#
# Constraints:
#   No sed. No rm -rf. No set -e. No exit 1. No 2>/dev/null.
#   No bare kill. main() wrapper. python3 for json pretty-print and edits.
#
set -o pipefail

C="opencode-deepseek-web"
COMPOSE_REL="docker/docker-compose.yml"
DATA_CONT="/home/node/.local/share/opencode"
DATA_HOST_REL="data/opencode"
HTTP_URL="http://127.0.0.1:4096"
MODEL="deepseek/deepseek-flash"

resolve_repo() {
    local c="$1"
    while [ "$c" != "/" ]; do
        if [ -f "$c/opencode.json" ] && [ -f "$c/docker/Dockerfile" ]; then
            printf '%s' "$c"; return 0
        fi
        c=$(dirname "$c")
    done
    return 1
}

section() { printf '\n=== %s ===\n' "$1"; }

indent() {
    local line
    while IFS= read -r line; do
        printf '%s%s\n' '    ' "$line"
    done
}

have() { command -v "$1" >/dev/null 2>&1; }

print_raw_block() {
    local f="$1"
    local start end
    start=$(grep -nE '^[[:space:]]*opencode-web:[[:space:]]*$' "$f" | head -1 | cut -d: -f1)
    if [ -z "$start" ]; then
        printf '    (no opencode-web service found)\n'
        return 0
    fi
    end=$(awk -v s="$start" '
        NR > s && /^[[:space:]]*[A-Za-z][^:]*:[[:space:]]*$/ {
            match($0, /^[[:space:]]*/); ind = RLENGTH
            if (ind <= 2) { print NR; exit }
        }
    ' "$f")
    [ -z "$end" ] && end=$((start + 40))
    awk -v s="$start" -v e="$end" 'NR>=s && NR<e { printf "    %4d  %s\n", NR, $0 }' "$f"
}

print_live_mounts() {
    local json
    json=$(docker inspect "$C" --format '{{json .Mounts}}' 2>&1)
    [ -z "$json" ] && { printf '    (no data)\n'; return; }
    if have python3; then
        printf '%s' "$json" | python3 -m json.tool 2>&1 | indent
    else
        printf '    %s\n' "$json"
    fi
}

live_has_data_mount() {
    docker inspect "$C" --format '{{json .Mounts}}' 2>&1 \
      | grep -F "\"Destination\":\"$DATA_CONT\"" >/dev/null
}

wait_http() {
    local tries=0 code=""
    while [ "$tries" -lt 60 ]; do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 3 "$HTTP_URL/" 2>&1)
        printf '    %2d/60  http=%s\n' "$((tries + 1))" "$code"
        [ -n "$code" ] && [ "$code" != "000" ] && break
        tries=$((tries + 1)); sleep 2
    done
}

rewrite_block() {
    local compose="$1" ts="$2"
    cp "$compose" "$compose.bak.${ts}"
    printf '  backup: %s.bak.%s\n' "$compose" "$ts"

    python3 - "$compose" <<'PY'
import re, sys
path = sys.argv[1]
with open(path) as fh:
    text = fh.read()

TEMPLATE = """  opencode-web:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    image: opencode-deepseek-jev:robust
    container_name: opencode-deepseek-web
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    working_dir: /workspace
    entrypoint: ["/workspace/docker/web-entrypoint.sh"]
    ports:
      - "4096:4096"
    volumes:
      - ..:/workspace
      - ../data/opencode:/home/node/.local/share/opencode
    env_file:
      - ../.env.local
    environment:
      OPENCODE_DISABLE_DEFAULT_PLUGINS: "true"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
"""

pat = re.compile(r'^  opencode-web:\n(?:[ \t].*\n|\n)*?(?=^  [a-zA-Z]|\Z)', re.MULTILINE)
m = pat.search(text)
if not m:
    print("  FAIL: opencode-web block not matched by regex")
    sys.exit(3)

text = text[:m.start()] + TEMPLATE + text[m.end():]
with open(path, "w") as fh:
    fh.write(text)
print("  opencode-web block rewritten with data mount")
PY
    return $?
}

# Prints session count to stdout; writes raw API body to $2.
count_sessions() {
    local auth="$1" outfile="$2"
    curl -s -u "$auth" -m 5 "$HTTP_URL/api/session" -o "$outfile" 2>&1
    if grep -q '"data"' "$outfile" 2>&1; then
        grep -o '"id":"ses_' "$outfile" | wc -l | tr -d ' '
    else
        printf 'ERR'
    fi
}

main() {
    local script_dir repo compose data_host ts
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo=$(resolve_repo "$script_dir")
    [ -z "$repo" ] && repo=$(resolve_repo "$PWD")
    [ -z "$repo" ] && { printf 'GATE FAIL: cannot resolve repo\n'; return 2; }
    compose="$repo/$COMPOSE_REL"
    data_host="$repo/$DATA_HOST_REL"
    ts=$(date -u +%Y%m%dT%H%M%SZ)

    printf '=== fix-data-persistence-v4.1.sh ===\n'
    printf 'Repo:    %s\n' "$repo"
    printf 'Compose: %s\n' "$compose"
    printf 'TS:      %s\n' "$ts"

    [ -f "$compose" ] || { printf 'GATE FAIL: compose not found\n'; return 1; }
    have python3 || { printf 'GATE FAIL: python3 required\n'; return 1; }
    have curl    || { printf 'GATE FAIL: curl required\n'; return 1; }

    [ -d "$data_host" ] || mkdir -p "$data_host"
    chown -R "$(id -u):$(id -g)" "$data_host" 2>&1 || true

    section "R1  current state"
    printf 'raw compose block:\n'
    print_raw_block "$compose"
    printf '\nlive .Mounts:\n'
    print_live_mounts

    section "R2  decision"
    if live_has_data_mount; then
        printf '  R2  mount already active\n'
    else
        printf '  R2  mount NOT active — rewriting opencode-web block\n'
        if ! rewrite_block "$compose" "$ts"; then
            printf '  rewrite failed\n'
            return 1
        fi
        if ! ( cd "$repo/docker" && docker compose config >/dev/null 2>&1 ); then
            printf '  FAIL: compose config rejects rewritten file\n'
            printf '  rollback: cp %s.bak.%s %s\n' "$compose" "$ts" "$compose"
            return 1
        fi
        printf '  compose config: OK\n'

        section "R3  recreate"
        ( cd "$repo/docker" && docker compose up -d --force-recreate opencode-web )
        [ $? -ne 0 ] && { printf '  FAIL: compose up\n'; return 1; }
        wait_http
        printf '\n  .Mounts after recreate:\n'
        print_live_mounts
        if ! live_has_data_mount; then
            section "verdict"
            printf '  FAIL — rewrite did not produce an active mount.\n'
            printf '  Reproduce:\n'
            printf '    docker inspect %s --format "{{json .Mounts}}"\n' "$C"
            printf '    docker compose -f %s config | grep -A6 volumes\n' "$compose"
            return 1
        fi
        printf '\n  R3  mount active\n'
    fi

    section "persistence test"
    local pass
    pass=$(docker exec "$C" sh -c 'printf "%s" "$OPENCODE_SERVER_PASSWORD"' 2>&1)
    [ -z "$pass" ] && { printf '  INCONCLUSIVE: password empty\n'; return 1; }
    local auth="opencode:$pass"

    printf '\n  creating two sessions\n'
    local log1 log2
    log1="/tmp/p1-${ts}.log"
    log2="/tmp/p2-${ts}.log"
    docker exec -w /workspace "$C" sh -c \
        "opencode run --model '$MODEL' 'Reply with exactly: P1'" > "$log1" 2>&1
    docker exec -w /workspace "$C" sh -c \
        "opencode run --model '$MODEL' 'Reply with exactly: P2'" > "$log2" 2>&1

    local p1=0 p2=0
    grep -q 'P1' "$log1" && p1=1
    grep -q 'P2' "$log2" && p2=1
    printf '  P1: %s   P2: %s\n' "$p1" "$p2"
    if [ "$p1" -eq 0 ] || [ "$p2" -eq 0 ]; then
        printf '  INCONCLUSIVE — a model run failed\n'
        printf '  P1 tail:\n'; tail -5 "$log1" | indent
        printf '  P2 tail:\n'; tail -5 "$log2" | indent
        return 1
    fi

    local before_body after_body before after
    before_body="/tmp/before-body-${ts}.json"
    after_body="/tmp/after-body-${ts}.json"

    before=$(count_sessions "$auth" "$before_body")
    printf '\n  before recreate: %s sessions\n' "$before"
    printf '  api body: %s\n' "$(head -c 300 "$before_body")"

    if [ "$before" = "ERR" ]; then
        printf '  INCONCLUSIVE — /api/session did not return JSON\n'
        return 1
    fi
    if [ "$before" -lt 2 ]; then
        printf '  INCONCLUSIVE — fewer than 2 sessions visible (%s)\n' "$before"
        return 1
    fi

    printf '\n  host data dir:\n'
    ls -la "$data_host" | indent

    printf '\n  recreating\n'
    ( cd "$repo/docker" && docker compose up -d --force-recreate opencode-web >/dev/null 2>&1 )
    wait_http

    after=$(count_sessions "$auth" "$after_body")
    printf '  after recreate: %s sessions\n' "$after"
    printf '  api body: %s\n' "$(head -c 300 "$after_body")"
    printf '\n  host data dir after recreate:\n'
    ls -la "$data_host" | indent

    section "verdict"
    [ "$after" = "ERR" ] && { printf '  INCONCLUSIVE — post-recreate api failed\n'; return 1; }
    if [ "$after" = "$before" ] && [ "$before" -ge 2 ]; then
        printf '  PASS — %s sessions survived the recreate\n' "$before"
        printf '  refresh the browser at %s\n' "$HTTP_URL"
        return 0
    fi
    printf '  FAIL — before=%s after=%s\n' "$before" "$after"
    return 1
}

main "$@"
