#!/usr/bin/env bash
#
# normalize-opencode-web-service.sh — ensure the opencode-web service in
# docker/docker-compose.yml has the correct environment, env_file, and
# structural shape.
#
# Ground truth: `docker compose config` output for the opencode-web
# service. If its environment contains the expected four keys and its
# env_file contains ../.env.local, the raw file is left untouched.
#
# If the check fails, the raw opencode-web service block is replaced
# with a known-good template. The rest of the file (other services,
# version key, comments above opencode-web) is preserved.
#
# Idempotent. Backs up compose file.
#
# Constraints:
#   No sed. No rm -rf. No set -e. No exit 1. No 2>/dev/null.
#   No bare kill. main() wrapper. python3 for text edits.
#
set -o pipefail

C="opencode-deepseek-web"
HTTP_URL="http://127.0.0.1:4096"
COMPOSE_REL="docker/docker-compose.yml"

EXPECTED_ENV="DEEPSEEK_API_KEY JEV_API_KEY OPENCODE_DISABLE_DEFAULT_PLUGINS OPENCODE_SERVER_PASSWORD"
EXPECTED_ENV_FILE="../.env.local"

resolve_repo() {
    local c="$1"
    while [ "$c" != "/" ]; do
        if [ -f "$c/opencode.json" ] && [ -f "$c/docker/Dockerfile" ]; then
            printf '%s' "$c"; return 0
        fi
        c=$(dirname "$c")
    done
    return 1
}

section() { printf '\n=== %s ===\n' "$1"; }

indent() {
    local line
    while IFS= read -r line; do
        printf '%s%s\n' '    ' "$line"
    done
}

mask() {
    local s="$1"
    if [ ${#s} -le 12 ]; then printf '***'; return 0; fi
    printf '%s...%s' \
        "$(printf '%s' "$s" | cut -c1-8)" \
        "$(printf '%s' "$s" | rev | cut -c1-6 | rev)"
}

main() {
    local script_dir repo compose ts
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo=$(resolve_repo "$script_dir")
    [ -z "$repo" ] && repo=$(resolve_repo "$PWD")
    if [ -z "$repo" ]; then
        printf 'GATE FAIL: cannot resolve repo\n'
        return 2
    fi
    compose="$repo/$COMPOSE_REL"
    ts=$(date -u +%Y%m%dT%H%M%SZ)

    printf '=== normalize-opencode-web-service.sh ===\n'
    printf 'Compose: %s\n' "$compose"

    if [ ! -f "$compose" ]; then
        printf 'GATE FAIL: %s not found\n' "$compose"
        return 1
    fi

    section "1. docker compose config (opencode-web, authoritative)"
    ( cd "$repo/docker" && docker compose config 2>&1 ) | \
        awk '/^  opencode-web:/{s=1} s{print} s && /^  [a-zA-Z]/{exit}' | indent

    section "2. parsed environment keys for opencode-web"
    local parsed_env
    parsed_env=$( cd "$repo/docker" && docker compose config 2>&1 ) || true

    local missing=0
    for k in $EXPECTED_ENV; do
        if printf '%s\n' "$parsed_env" | grep -qE "^[[:space:]]*${k}:"; then
            printf '  present: %s\n' "$k"
        else
            printf '  MISSING: %s\n' "$k"
            missing=1
        fi
    done

    if printf '%s\n' "$parsed_env" | grep -q "${EXPECTED_ENV_FILE}"; then
        printf '  present: env_file %s\n' "$EXPECTED_ENV_FILE"
    else
        printf '  MISSING: env_file %s\n' "$EXPECTED_ENV_FILE"
        missing=1
    fi

    if [ "$missing" -eq 0 ]; then
        printf '\n  no changes needed — compose already correct.\n'
    else
        section "3. rewrite opencode-web service block"
        cp "$compose" "$compose.bak.${ts}"
        printf '  backup: %s.bak.%s\n' "$compose" "$ts"

        python3 - "$compose" <<'PY'
import re, sys

path = sys.argv[1]
with open(path) as fh:
    text = fh.read()

TEMPLATE = """  opencode-web:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    image: opencode-deepseek-jev:robust
    container_name: opencode-deepseek-web
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    working_dir: /workspace
    entrypoint: ["/workspace/docker/web-entrypoint.sh"]
    ports:
      - "4096:4096"
    volumes:
      - ..:/workspace
    environment:
      - DEEPSEEK_API_KEY
      - JEV_API_KEY
      - OPENCODE_DISABLE_DEFAULT_PLUGINS=true
      - OPENCODE_SERVER_PASSWORD
    env_file:
      - ../.env.local
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
"""

# Match the opencode-web block: from "  opencode-web:" to the next
# top-level service or EOF.
pattern = re.compile(
    r"(^  opencode-web:\n)((?:[ ]{4,}[^\n]*\n|\n)*)",
    re.MULTILINE,
)
if not pattern.search(text):
    print("  WARN: opencode-web service header not found; no rewrite")
    sys.exit(0)

new_text, n = pattern.subn(TEMPLATE, text, count=1)
if n == 0:
    print("  WARN: substitution did not apply")
    sys.exit(0)

with open(path, "w") as fh:
    fh.write(new_text)
print("  opencode-web block replaced")
PY

        section "4. validate with docker compose config"
        ( cd "$repo/docker" && docker compose config >/dev/null 2>&1 )
        local cfg_rc=$?
        if [ "$cfg_rc" -ne 0 ]; then
            printf '  FAIL: compose config rejected the rewritten file (rc=%d)\n' "$cfg_rc"
            printf '  rollback: cp %s.bak.%s %s\n' "$compose" "$ts" "$compose"
            return 1
        fi
        printf '  compose config: OK\n'
    fi

    section "5. recreate container"
    ( cd "$repo/docker" && docker compose up -d --force-recreate opencode-web )
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        printf '  FAIL: compose up returned %d\n' "$rc"
        return 1
    fi

    section "6. wait for HTTP"
    local tries=0 code=""
    while [ "$tries" -lt 60 ]; do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 3 "$HTTP_URL/" 2>&1)
        printf '  %2d/60  http=%s\n' "$((tries + 1))" "$code"
        [ -n "$code" ] && [ "$code" != "000" ] && break
        tries=$((tries + 1))
        sleep 2
    done

    section "7. container env after recreate"
    docker exec "$C" sh -c 'env | grep -E "^(DEEPSEEK|JEV|OPENCODE)" | sort' 2>&1 | \
        while IFS='=' read -r k v; do
            case "$k" in
                DEEPSEEK_API_KEY|JEV_API_KEY|OPENCODE_SERVER_PASSWORD)
                    printf '  %s=%s\n' "$k" "$(mask "$v")" ;;
                *)
                    printf '  %s=%s\n' "$k" "$v" ;;
            esac
        done

    section "8. verify auth.json + providers"
    docker exec "$C" sh -c 'ls -la /home/node/.local/share/opencode/auth.json' 2>&1 | indent
    docker exec -w /workspace "$C" sh -c 'opencode providers list' 2>&1 | indent

    section "9. final structural check of raw file"
    local still_missing=0
    for k in $EXPECTED_ENV; do
        if ! grep -qE "^[[:space:]]*-[[:space:]]*${k}(=|$)" "$compose" && \
           ! grep -qE "^[[:space:]]*${k}:" "$compose"; then
            printf '  raw file missing: %s\n' "$k"
            still_missing=1
        fi
    done
    if [ "$still_missing" -eq 0 ]; then
        printf '  raw file: all four env entries present\n'
    fi

    section "summary"
    printf '  compose: %s\n' "$compose"
    printf '  HTTP:    %s\n' "$code"
    return 0
}

main "$@"
