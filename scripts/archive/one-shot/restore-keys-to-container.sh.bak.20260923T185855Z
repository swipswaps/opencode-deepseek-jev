#!/usr/bin/env bash
#
# restore-keys-to-container.sh — read .env.local, export to the shell,
# recreate the container so the pass-through environment block works.
#
# This is the recovery from the 2026-09-23 rotation bug where
# rotate-keys-guided.sh wrote .env.local but did not export the vars
# before `docker compose up`.
#
# Constraints:
#   No sed. No rm -rf. No set -e. No exit 1. No 2>/dev/null.
#   No bare kill. main() wrapper.
#
set -o pipefail

C="opencode-deepseek-web"
HTTP_URL="http://127.0.0.1:4096"

section() { printf '\n=== %s ===\n' "$1"; }

indent() {
    local line
    while IFS= read -r line; do
        printf '%s%s\n' '    ' "$line"
    done
}

mask() {
    local s="$1"
    if [ ${#s} -le 12 ]; then printf '***'; return 0; fi
    printf '%s...%s' \
        "$(printf '%s' "$s" | cut -c1-8)" \
        "$(printf '%s' "$s" | rev | cut -c1-6 | rev)"
}

resolve_repo() {
    local c="$1"
    while [ "$c" != "/" ]; do
        if [ -f "$c/opencode.json" ] && [ -f "$c/docker/Dockerfile" ]; then
            printf '%s' "$c"; return 0
        fi
        c=$(dirname "$c")
    done
    return 1
}

main() {
    local script_dir repo env_file
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo=$(resolve_repo "$script_dir")
    [ -z "$repo" ] && repo=$(resolve_repo "$PWD")
    if [ -z "$repo" ]; then
        printf 'GATE FAIL: cannot resolve repo\n'
        return 2
    fi
    env_file="$repo/.env.local"

    printf '=== restore-keys-to-container.sh ===\n'
    printf 'Repo: %s\n' "$repo"
    printf 'TS:   %s\n' "$(date -u +%Y%m%dT%H%M%SZ)"

    section "0. read .env.local"
    if [ ! -f "$env_file" ]; then
        printf '  GATE FAIL: %s missing\n' "$env_file"
        return 1
    fi
    DEEPSEEK_API_KEY=""
    JEV_API_KEY=""
    while IFS='=' read -r k v; do
        case "$k" in
            DEEPSEEK_API_KEY) DEEPSEEK_API_KEY="$v" ;;
            JEV_API_KEY)      JEV_API_KEY="$v" ;;
        esac
    done < "$env_file"

    if [ -z "$DEEPSEEK_API_KEY" ] || [ -z "$JEV_API_KEY" ]; then
        printf '  GATE FAIL: one or both keys empty in .env.local\n'
        return 1
    fi
    printf '  DEEPSEEK_API_KEY=%s\n' "$(mask "$DEEPSEEK_API_KEY")"
    printf '  JEV_API_KEY=%s\n'      "$(mask "$JEV_API_KEY")"

    section "1. export to shell"
    export DEEPSEEK_API_KEY JEV_API_KEY
    printf '  exported\n'

    section "2. recreate container"
    cd "$repo/docker" || return 1
    docker compose up -d --force-recreate opencode-web
    local rc=$?
    cd "$repo" || return 1
    if [ "$rc" -ne 0 ]; then
        printf '  FAIL: compose up returned %d\n' "$rc"
        return 1
    fi

    section "3. wait for HTTP"
    local tries=0 code=""
    while [ "$tries" -lt 60 ]; do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 3 "$HTTP_URL/" 2>&1)
        printf '  %2d/60  http=%s\n' "$((tries + 1))" "$code"
        [ -n "$code" ] && [ "$code" != "000" ] && break
        tries=$((tries + 1))
        sleep 2
    done

    section "4. verify env in container"
    docker exec "$C" sh -c 'env | grep -E "^(DEEPSEEK|JEV)_API_KEY="' 2>&1 | \
        while IFS='=' read -r k v; do
            printf '  %s=%s\n' "$k" "$(mask "$v")"
        done

    section "5. verify auth.json"
    docker exec "$C" sh -c 'ls -la /home/node/.local/share/opencode/auth.json' 2>&1 | indent

    section "6. verify providers"
    docker exec -w /workspace "$C" sh -c 'opencode providers list' 2>&1 | indent

    printf '\n=== done ===\n'
    printf 'If auth.json is present and providers shows DeepSeek, the stack is restored.\n'
    return 0
}

main "$@"
