#!/usr/bin/env bash
#
# rotate-keys-guided.sh — guided, headed Playwright key rotation.
#
# The user completes the browser steps in a VISIBLE window. The script
# observes the DOM, captures the new key when it appears, and handles
# everything downstream (env write, container recreate, verify).
#
# Fallback chain:
#   1. Playwright (headed, persistent profile)  — primary
#   2. xdotool (X11)                            — if Playwright unavailable
#   3. stdin paste                              — always works
#
# Constraints:
#   No sed. No rm -rf. No set -e. No exit 1. No 2>/dev/null.
#   No bare kill. main() wrapper.
#
# Citations:
#   POSIX printf(1):
#     https://pubs.opengroup.org/onlinepubs/9699919799/utilities/printf.html
#   Playwright persistent context (launch_persistent_context):
#     https://playwright.dev/python/docs/api/class-browsertype#browser-type-launch-persistent-context
#   Playwright codegen (record → script):
#     https://playwright.dev/docs/codegen-intro
#   Playwright headed + persistent profile pattern:
#     https://github.com/jikig-ai/soleur/blob/main/knowledge-base/project/learnings/2026-05-15-playwright-mcp-headed-and-persistent-profile.md
#   xdotool (X11 automation):
#     https://www.semicomplete.com/projects/xdotool/
#   DeepSeek API keys console:
#     https://platform.deepseek.com/api_keys
#   TypeSafe keys console:
#     https://console.typesafe.ai/settings/keys
#   Docker compose up:
#     https://docs.docker.com/compose/reference/up/
#   Kernighan & Pike, "The Practice of Programming", Addison-Wesley,
#   1999. ISBN-13: 978-0201615869. §5.1 "Debugging".
#
set -o pipefail

C="opencode-deepseek-web"
DEEPSEEK_CONSOLE="https://platform.deepseek.com/api_keys"
JEV_CONSOLE="https://console.typesafe.ai/settings/keys"
PROFILE_DIR="$HOME/.cache/opencode-rotation-playwright"
TIMEOUT_PER_STEP=300   # seconds to wait for the user at each step

section() { printf '\n=== %s ===\n' "$1"; }

indent() {
    local line
    while IFS= read -r line; do
        printf '%s%s\n' '    ' "$line"
    done
}

have() { command -v "$1" >/dev/null 2>&1; }

resolve_repo() {
    local c="$1"
    while [ "$c" != "/" ]; do
        if [ -f "$c/opencode.json" ] && [ -f "$c/docker/Dockerfile" ]; then
            printf '%s' "$c"; return 0
        fi
        c=$(dirname "$c")
    done
    return 1
}

# --------------------------------------------------------------------------
# Detect which browser backend is available.
# Returns: playwright | xdotool | stdin
# --------------------------------------------------------------------------
detect_backend() {
    if have python3 && python3 -c 'import playwright' >/dev/null 2>&1; then
        printf 'playwright'
        return 0
    fi
    if have xdotool && have import; then
        printf 'xdotool'
        return 0
    fi
    printf 'stdin'
    return 0
}

# --------------------------------------------------------------------------
# Backend: Playwright
# Writes captured keys to $1 (deepseek) and $2 (jev).
# Returns 0 on success, 1 on failure.
# --------------------------------------------------------------------------
run_playwright() {
    local out_ds="$1" out_jev="$2"

    printf 'backend: playwright (headed, persistent profile)\n'
    printf 'profile: %s\n' "$PROFILE_DIR"

    # Ensure the profile dir exists and playwright chromium is installed.
    mkdir -p "$PROFILE_DIR"
    python3 -m playwright install chromium >/dev/null 2>&1 || {
        printf '  FAIL: playwright chromium not installed\n'
        printf '  run: python3 -m playwright install chromium\n'
        return 1
    }

    python3 - "$DEEPSEEK_CONSOLE" "$JEV_CONSOLE" "$PROFILE_DIR" "$out_ds" "$out_jev" "$TIMEOUT_PER_STEP" <<'PY_EOF'
import sys, os, time
from pathlib import Path
from playwright.sync_api import sync_playwright, TimeoutError as PWTimeout

deepseek_url, jev_url, profile, out_ds, out_jev, timeout_s = sys.argv[1:7]
timeout_ms = int(timeout_s) * 1000

def wait_for_user(context, page, step_label, check_fn):
    """Poll page for up to timeout_s. check_fn returns a value or None."""
    print(f"  waiting for user: {step_label}")
    print(f"  (browser is open — complete the step, then the script continues)")
    print(f"  timeout: {timeout_s} seconds")
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        try:
            val = check_fn(page)
        except Exception:
            val = None
        if val:
            return val
        time.sleep(1)
    return None

with sync_playwright() as p:
    # launch_persistent_context: cookies + auth survive across runs
    ctx = p.chromium.launch_persistent_context(
        user_data_dir=profile,
        headless=False,
        args=[
            "--disable-blink-features=AutomationControlled",
            "--ozone-platform=wayland",   # Fedora GNOME default
            "--password-store=basic",
            "--use-mock-keychain",
        ],
        viewport={"width": 1280, "height": 900},
    )
    page = ctx.pages[0] if ctx.pages else ctx.new_page()

    # ---------------------------------------------------------------
    # STEP 1: DeepSeek
    # ---------------------------------------------------------------
    print("")
    print("=" * 60)
    print("STEP 1 / 2  DeepSeek")
    print("=" * 60)
    print(f"opening {deepseek_url}")
    page.goto(deepseek_url, wait_until="domcontentloaded", timeout=60000)

    # If a login form is visible, the user logs in now.
    if page.locator('input[type="password"]').count() > 0:
        print("login form detected — log in in the browser window")
        print("(the script waits here until the API keys page is visible)")
        try:
            page.wait_for_selector(
                'button:has-text("Create new API key"), '
                'button:has-text("Create new key"), '
                '[data-testid*="api-key"]',
                timeout=timeout_ms,
            )
        except PWTimeout:
            print("  FAIL: login did not complete within timeout")
            ctx.close()
            sys.exit(2)

    print("")
    print("In the browser now:")
    print("  1. Find the key currently in .env.local (see R2 mask in the shell)")
    print("  2. Click Revoke / Delete on that key")
    print("  3. Click 'Create new API key'")
    print("  4. Copy the new key (starts with sk-)")
    print("")
    print("The script watches the page and will capture the key when it appears.")

    # Poll for the key-display modal. DeepSeek shows the full key once,
    # typically in a <code>, <pre>, or [data-testid="api-key"] element.
    def grab_deepseek_key(pg):
        # Several selector candidates — consoles change markup.
        selectors = [
            '[data-testid="api-key"]',
            '.key-display code',
            '.key-display',
            'code:has-text("sk-")',
            'pre:has-text("sk-")',
        ]
        for sel in selectors:
            try:
                loc = pg.locator(sel).first
                if loc.count() > 0:
                    txt = loc.text_content(timeout=500)
                    if txt and txt.strip().startswith("sk-"):
                        return txt.strip()
            except Exception:
                continue
        # Fallback: scan the whole body text for a sk- token.
        try:
            body = pg.locator("body").text_content(timeout=500)
            import re
            m = re.search(r'sk-[A-Za-z0-9]{20,}', body)
            if m:
                return m.group(0)
        except Exception:
            pass
        return None

    ds_key = wait_for_user(page, page, "DeepSeek key creation", grab_deepseek_key)
    if not ds_key:
        print("  FAIL: DeepSeek key not captured within timeout")
        print("  falling back to stdin for this key")
        ds_key = ""

    # ---------------------------------------------------------------
    # STEP 2: TypeSafe / JEV
    # ---------------------------------------------------------------
    print("")
    print("=" * 60)
    print("STEP 2 / 2  TypeSafe (JEV)")
    print("=" * 60)
    print(f"opening {jev_url}")
    page.goto(jev_url, wait_until="domcontentloaded", timeout=60000)

    if page.locator('input[type="password"]').count() > 0:
        print("login form detected — log in in the browser window")
        try:
            page.wait_for_selector(
                'button:has-text("Create"), [data-testid*="key"]',
                timeout=timeout_ms,
            )
        except PWTimeout:
            print("  FAIL: login did not complete within timeout")
            ctx.close()
            sys.exit(2)

    print("")
    print("In the browser now:")
    print("  1. Find the key currently in .env.local")
    print("  2. Click Revoke / Delete on that key")
    print("  3. Click 'Create new key'")
    print("  4. Copy the new key (starts with apikey_)")
    print("")
    print("The script watches the page and will capture the key when it appears.")

    def grab_jev_key(pg):
        selectors = [
            '[data-testid="api-key"]',
            '.key-display code',
            '.key-display',
            'code:has-text("apikey_")',
            'pre:has-text("apikey_")',
        ]
        for sel in selectors:
            try:
                loc = pg.locator(sel).first
                if loc.count() > 0:
                    txt = loc.text_content(timeout=500)
                    if txt and txt.strip().startswith("apikey_"):
                        return txt.strip()
            except Exception:
                continue
        try:
            body = pg.locator("body").text_content(timeout=500)
            import re
            m = re.search(r'apikey_[A-Za-z0-9_]{20,}', body)
            if m:
                return m.group(0)
        except Exception:
            pass
        return None

    jev_key = wait_for_user(page, page, "JEV key creation", grab_jev_key)
    if not jev_key:
        print("  FAIL: JEV key not captured within timeout")
        print("  falling back to stdin for this key")
        jev_key = ""

    # Write captured keys to the output files.
    Path(out_ds).write_text(ds_key)
    Path(out_jev).write_text(jev_key)

    print("")
    print("browser session complete.")
    print(f"  DeepSeek key captured: {'yes' if ds_key else 'no'}")
    print(f"  JEV key captured:      {'yes' if jev_key else 'no'}")

    # Keep the browser open long enough for the user to verify, then close.
    print("closing browser in 5 seconds...")
    page.wait_for_timeout(5000)
    ctx.close()
PY_EOF
    return $?
}

# --------------------------------------------------------------------------
# Backend: xdotool (X11 fallback)
# Opens the URLs in the user's default browser, then relies on clipboard.
# --------------------------------------------------------------------------
run_xdotool() {
    local out_ds="$1" out_jev="$2"

    printf 'backend: xdotool (X11)\n'
    printf 'This backend opens your default browser and uses the clipboard.\n'
    printf 'It cannot read the DOM — you copy each key, the script reads the clipboard.\n\n'

    # Requires xclip for clipboard read.
    if ! have xclip; then
        printf '  FAIL: xclip not installed (sudo dnf install xclip)\n'
        return 1
    fi

    printf 'Opening %s\n' "$DEEPSEEK_CONSOLE"
    have xdg-open && xdg-open "$DEEPSEEK_CONSOLE" >/dev/null 2>&1 || true
    printf '\nIn the browser:\n'
    printf '  1. Revoke the old DeepSeek key\n'
    printf '  2. Create a new key\n'
    printf '  3. Copy the new key to clipboard\n'
    printf '\nPress Enter here when the key is on your clipboard: '
    read -r _
    local ds_key
    ds_key=$(xclip -selection clipboard -o 2>&1 | tr -d '\n')
    printf '  clipboard: %s...%s\n' \
        "$(printf '%s' "$ds_key" | cut -c1-8)" \
        "$(printf '%s' "$ds_key" | rev | cut -c1-6 | rev)"
    printf '%s' "$ds_key" > "$out_ds"

    printf '\nOpening %s\n' "$JEV_CONSOLE"
    have xdg-open && xdg-open "$JEV_CONSOLE" >/dev/null 2>&1 || true
    printf '\nIn the browser:\n'
    printf '  1. Revoke the old JEV key\n'
    printf '  2. Create a new key\n'
    printf '  3. Copy the new key to clipboard\n'
    printf '\nPress Enter here when the key is on your clipboard: '
    read -r _
    local jev_key
    jev_key=$(xclip -selection clipboard -o 2>&1 | tr -d '\n')
    printf '  clipboard: %s...%s\n' \
        "$(printf '%s' "$jev_key" | cut -c1-8)" \
        "$(printf '%s' "$jev_key" | rev | cut -c1-6 | rev)"
    printf '%s' "$jev_key" > "$out_jev"

    return 0
}

# --------------------------------------------------------------------------
# Backend: stdin (always works)
# --------------------------------------------------------------------------
run_stdin() {
    local out_ds="$1" out_jev="$2"

    printf 'backend: stdin (manual paste)\n\n'
    printf 'Opening %s\n' "$DEEPSEEK_CONSOLE"
    have xdg-open && xdg-open "$DEEPSEEK_CONSOLE" >/dev/null 2>&1 || true
    printf '\nPaste NEW DeepSeek key (hidden), then Enter: '
    read -r -s ds
    printf '\n'
    printf 'Opening %s\n' "$JEV_CONSOLE"
    have xdg-open && xdg-open "$JEV_CONSOLE" >/dev/null 2>&1 || true
    printf '\nPaste NEW JEV key (hidden), then Enter:      '
    read -r -s jev
    printf '\n'
    printf '%s' "$ds" > "$out_ds"
    printf '%s' "$jev" > "$out_jev"
    return 0
}

# --------------------------------------------------------------------------
main() {
    printf '=== rotate-keys-guided.sh ===\n'
    printf 'TS: %s\n' "$(date -u +%Y%m%dT%H%M%SZ)"

    local repo env_file ts
    repo=$(resolve_repo "$PWD")
    [ -z "$repo" ] && repo=$(resolve_repo "$(dirname "${BASH_SOURCE[0]}")")
    if [ -z "$repo" ]; then
        printf 'GATE FAIL: cannot resolve repo\n'
        return 2
    fi
    env_file="$repo/.env.local"
    ts=$(date -u +%Y%m%dT%H%M%SZ)

    if [ ! -f "$env_file" ]; then
        printf 'GATE FAIL: %s missing\n' "$env_file"
        return 1
    fi

    section "0. backend detection"
    local backend
    backend=$(detect_backend)
    printf '  selected: %s\n' "$backend"
    printf '  alternatives: playwright (primary) | xdotool (X11) | stdin (always)\n'

    section "1. backup"
    cp "$env_file" "$env_file.bak.${ts}"
    printf '  backup: %s.bak.%s\n' "$env_file" "$ts"

    section "2. guided rotation"
    local ds_tmp jev_tmp
    ds_tmp=$(mktemp)
    jev_tmp=$(mktemp)

    case "$backend" in
        playwright) run_playwright "$ds_tmp" "$jev_tmp" || backend="stdin" ;;
        xdotool)    run_xdotool    "$ds_tmp" "$jev_tmp" || backend="stdin" ;;
    esac

    if [ "$backend" = "stdin" ]; then
        run_stdin "$ds_tmp" "$jev_tmp" || { printf 'FAIL: stdin input failed\n'; return 1; }
    fi

    local ds_key jev_key
    ds_key=$(cat "$ds_tmp")
    jev_key=$(cat "$jev_tmp")

    # If Playwright/xdotool captured nothing, fall back to stdin per key.
    if [ -z "$ds_key" ]; then
        printf '\n  DeepSeek key not captured — paste manually.\n'
        printf '  Paste NEW DeepSeek key (hidden): '
        read -r -s ds_key
        printf '\n'
    fi
    if [ -z "$jev_key" ]; then
        printf '\n  JEV key not captured — paste manually.\n'
        printf '  Paste NEW JEV key (hidden):      '
        read -r -s jev_key
        printf '\n'
    fi

    if [ -z "$ds_key" ] || [ -z "$jev_key" ]; then
        printf 'GATE FAIL: one or both keys empty; aborting without changes\n'
        return 1
    fi

    section "3. write .env.local (mode 0600)"
    (umask 077 && cat > "$env_file" <<EOF
DEEPSEEK_API_KEY=$ds_key
JEV_API_KEY=$jev_key
EOF
)
    chmod 600 "$env_file"
    ls -la "$env_file" | indent

    section "4. recreate container"
    cd "$repo/docker" || return 1
    docker compose up -d --force-recreate opencode-web
    local rc=$?
    cd "$repo" || return 1
    if [ "$rc" -ne 0 ]; then
        printf '  FAIL: compose up returned %d\n' "$rc"
        printf '  rollback: cp %s.bak.%s %s\n' "$env_file" "$ts" "$env_file"
        return 1
    fi

    section "5. verify"
    local verify="$repo/scripts/archive/one-shot/verify-api-keys.sh"
    if [ -x "$verify" ]; then
        "$verify" || true
    else
        printf '  verify-api-keys.sh not found; run it manually after this.\n'
    fi

    section "summary"
    printf '  backend used: %s\n' "$backend"
    printf '  env backup:   %s.bak.%s\n' "$env_file" "$ts"
    printf '  rollback:     cp %s.bak.%s %s\n' "$env_file" "$ts" "$env_file"
    printf '\n'
    return 0
}

main "$@"
