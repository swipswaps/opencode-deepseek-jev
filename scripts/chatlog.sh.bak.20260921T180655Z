#!/usr/bin/env bash
#
# chatlog.sh — manage chat logs stored alongside the repo.
#
# ============================================================================
# AUDIT — where chat logs live
# ============================================================================
#
# The user's session directory has this structure:
#
#   /home/owner/Documents/9e3e0363-0237-4c38-93dc-ce25e2f1ec37/
#       notes/    chat logs, analysis, working documents
#       repo/     the codebase
#
# Each session identifier is a UUID. Multiple sessions may exist under
# ~/Documents. This tool defaults to the notes directory that sits
# beside the repo containing this script, and can be pointed elsewhere
# with --dir.
#
# ============================================================================
# COMMANDS
# ============================================================================
#
#   list [-l]              list chat logs; -l adds line count and mtime
#   find <pattern>         find files by name
#   show <file>            print a log to stdout
#   search <pattern>       grep across all logs; shows file:line:match
#   ask <file> "<question>"  ask opencode a question grounded in <file>
#   summarize <file>       one-paragraph summary of <file>
#   decisions <file>       extract decisions stated in <file>
#   todos <file>           extract action items in <file>
#   repo-ask "<question>"  ask opencode a question grounded in the repo
#
# For ask/summarize/decisions/todos/repo-ask, the target file or the
# repo is mounted into the opencode container at /workspace, and
# opencode reads it via its own file access. The prompt names the file
# explicitly so the model knows what to open.
#
# ============================================================================
# CITATIONS
# ============================================================================
#
#   POSIX find(1)              https://pubs.opengroup.org/onlinepubs/9699919799/utilities/find.html
#   POSIX printf(1)            https://pubs.opengroup.org/onlinepubs/9699919799/utilities/printf.html
#   POSIX test(1)              https://pubs.opengroup.org/onlinepubs/9699919799/utilities/test.html
#   POSIX wc(1)                https://pubs.opengroup.org/onlinepubs/9699919799/utilities/wc.html
#   POSIX grep(1)              https://pubs.opengroup.org/onlinepubs/9699919799/utilities/grep.html
#   Bash parameter expansion   https://www.gnu.org/software/bash/manual/html_node/Shell-Parameter-Expansion.html
#   Bash pipefail              https://www.gnu.org/software/bash/manual/html_node/The-Set-Builtin.html
#   OpenCode CLI               https://opencode.ai/docs/cli/
#   Docker run                 https://docs.docker.com/engine/reference/commandline/run/
#
#   Kernighan & Pike, "The Practice of Programming", Addison-Wesley,
#   1999. ISBN-13: 978-0201615869. §6.3 "Finding the Bug".
#
#   Raymond, "The Art of Unix Programming", Addison-Wesley, 2003.
#   ISBN-13: 978-0131429017. §1.6.1 "Rule of Modularity".
#
# ============================================================================

set -o pipefail

# ----------------------------------------------------------------------------
# Resolve the repo root and default notes directory.
# ----------------------------------------------------------------------------
resolve_repo() {
    local candidate="$1"
    while [ "$candidate" != "/" ]; do
        if [ -f "$candidate/docker/Dockerfile" ]; then
            printf '%s' "$candidate"
            return 0
        fi
        candidate=$(dirname "$candidate")
    done
    return 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR=$(resolve_repo "$SCRIPT_DIR")
if [ -z "$REPO_DIR" ]; then
    REPO_DIR=$(resolve_repo "$PWD")
fi
if [ -z "$REPO_DIR" ]; then
    printf 'error: cannot locate repo root\n' >&2
    return 2
fi

# Default notes dir is sibling to the repo
DEFAULT_NOTES="$(dirname "$REPO_DIR")/notes"
NOTES_DIR="${CHATLOG_DIR:-$DEFAULT_NOTES}"

ASK_SCRIPT="$SCRIPT_DIR/ask.sh"

usage() {
    cat <<'USAGE_EOF'
chatlog.sh — manage chat logs alongside the repo

Commands:
  list [-l]                    list chat logs
  find <pattern>               find files by name
  show <file>                  print a log to stdout
  search <pattern>             search across all logs
  ask <file> "<question>"      ask opencode a question grounded in <file>
  summarize <file>             summarize <file>
  decisions <file>             extract decisions from <file>
  todos <file>                 extract action items from <file>
  repo-ask "<question>"        ask opencode about the repo

Environment:
  CHATLOG_DIR    override the notes directory (default: sibling of repo)

Options:
  --dir <path>   override the notes directory for this invocation
USAGE_EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
if [ $# -eq 0 ]; then
    usage
    return 2
fi

if [ "$1" = "--dir" ]; then
    NOTES_DIR="${2:-}"
    shift 2
fi

CMD="${1:-}"
shift

if [ ! -d "$NOTES_DIR" ]; then
    printf 'notes directory not found: %s\n' "$NOTES_DIR" >&2
    printf 'set CHATLOG_DIR or pass --dir <path>\n' >&2
    return 2
fi

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------
abs_path_of_log() {
    local f="$1"
    if [ -f "$f" ]; then
        printf '%s' "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
        return 0
    fi
    if [ -f "$NOTES_DIR/$f" ]; then
        printf '%s/%s' "$NOTES_DIR" "$f"
        return 0
    fi
    return 1
}

# ----------------------------------------------------------------------------
# Command dispatch
# ----------------------------------------------------------------------------
case "$CMD" in

    list)
        LONG=0
        [ "${1:-}" = "-l" ] && LONG=1
        if [ "$LONG" -eq 1 ]; then
            printf '%-60s %8s  %s\n' 'FILE' 'LINES' 'MODIFIED'
            find "$NOTES_DIR" -maxdepth 2 -type f \
                \( -name '*.txt' -o -name '*.md' \) 2>&1 | sort | while IFS= read -r f; do
                lines=$(wc -l < "$f" 2>&1)
                mtime=$(stat -c '%y' "$f" 2>&1 | cut -d. -f1)
                printf '%-60s %8s  %s\n' "${f#$NOTES_DIR/}" "$lines" "$mtime"
            done
        else
            find "$NOTES_DIR" -maxdepth 2 -type f \
                \( -name '*.txt' -o -name '*.md' \) 2>&1 | sort | while IFS= read -r f; do
                printf '%s\n' "${f#$NOTES_DIR/}"
            done
        fi
        ;;

    find)
        pattern="${1:-}"
        [ -z "$pattern" ] && { printf 'usage: chatlog.sh find <pattern>\n'; return 2; }
        find "$NOTES_DIR" -maxdepth 2 -type f -name "*${pattern}*" 2>&1 | sort
        ;;

    show)
        file="${1:-}"
        [ -z "$file" ] && { printf 'usage: chatlog.sh show <file>\n'; return 2; }
        p=$(abs_path_of_log "$file")
        if [ -z "$p" ]; then
            printf 'not found: %s\n' "$file" >&2
            return 1
        fi
        cat "$p"
        ;;

    search)
        pattern="${1:-}"
        [ -z "$pattern" ] && { printf 'usage: chatlog.sh search <pattern>\n'; return 2; }
        find "$NOTES_DIR" -maxdepth 2 -type f \
            \( -name '*.txt' -o -name '*.md' \) 2>&1 | sort | while IFS= read -r f; do
            grep -n -- "$pattern" "$f" 2>&1 | while IFS= read -r hit; do
                printf '%s:%s\n' "${f#$NOTES_DIR/}" "$hit"
            done
        done
        ;;

    ask|summarize|decisions|todos)
        file="${1:-}"
        [ -z "$file" ] && { printf 'usage: chatlog.sh %s <file> [question]\n' "$CMD"; return 2; }
        p=$(abs_path_of_log "$file")
        if [ -z "$p" ]; then
            printf 'not found: %s\n' "$file" >&2
            return 1
        fi
        log_dir=$(dirname "$p")
        log_name=$(basename "$p")

        case "$CMD" in
            ask)
                shift
                question="${*:-Summarize the key points.}"
                prompt="Read the file ./${log_name} in this directory. Answer this question about its contents, quoting specific lines when useful. Question: ${question}"
                ;;
            summarize)
                prompt="Read the file ./${log_name} in this directory. Produce a compact summary: purpose, key decisions, open questions, and any action items. Do not restate the whole file."
                ;;
            decisions)
                prompt="Read the file ./${log_name} in this directory. Extract every decision that was made. Format: one decision per line, prefixed with '- '. Include the reasoning if the file states it."
                ;;
            todos)
                prompt="Read the file ./${log_name} in this directory. Extract every action item, follow-up, or pending task. Format: one item per line, prefixed with '- '. Include who or when if stated."
                ;;
        esac

        if [ ! -x "$ASK_SCRIPT" ]; then
            printf 'error: %s not executable\n' "$ASK_SCRIPT" >&2
            return 1
        fi
        "$ASK_SCRIPT" --dir "$log_dir" "$prompt"
        ;;

    repo-ask)
        question="${*:-Summarize the repository.}"
        prompt="You are in a git repository mounted at /workspace. Inspect the structure, README, and any configuration files you find. Answer this question about the repository. Question: ${question}"
        if [ ! -x "$ASK_SCRIPT" ]; then
            printf 'error: %s not executable\n' "$ASK_SCRIPT" >&2
            return 1
        fi
        "$ASK_SCRIPT" --dir "$REPO_DIR" "$prompt"
        ;;

    *)
        usage
        return 2
        ;;

esac
