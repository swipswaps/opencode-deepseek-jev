[Unit]
Description=opencode-web + caddy access plane (waits for tunnel bind IPs)
Documentation=https://github.com/swipswaps/opencode-deepseek-jev
StartLimitIntervalSec=60
StartLimitBurst=5
# A user manager has no cross-manager ordering with system units, so
# `Wants=/After=network-online.target` would be a silent no-op here
# (systemd/systemd#3312). Ordering is instead done in scripts/web.sh:
# wait_for_bind_ips() polls until every pinned IP exists, and caddy publishes
# on the wildcard address so a missing tunnel IP cannot abort the bind.

[Service]
Type=oneshot
RemainAfterExit=yes
# REPO is baked in by scripts/web-install.sh (no sudo needed).
EnvironmentFile=-__REPO__/.env.local
ExecStart=__REPO__/scripts/web.sh
# web.sh already waits up to 30s per bind IP; this retry covers a late
# tailscale/nebula address or a docker daemon that was not ready yet.
Restart=on-failure
RestartSec=20
TimeoutStartSec=300
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
