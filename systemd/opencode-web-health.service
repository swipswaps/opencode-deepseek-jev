[Unit]
Description=opencode-web access-plane watchdog (certs + probes + recover)
Documentation=https://github.com/swipswaps/opencode-deepseek-jev
StartLimitIntervalSec=60
StartLimitBurst=5
# No network-online ordering: system targets are invisible to the user
# manager (systemd/systemd#3312); web-health.sh probes the interfaces itself.

[Service]
Type=oneshot
# REPO is baked in by scripts/web-install.sh (no sudo needed).
EnvironmentFile=-__REPO__/.env.local
ExecStart=__REPO__/scripts/web-health.sh --quiet
Nice=10
NoNewPrivileges=true
TimeoutStartSec=300
