# Caddyfile — TLS termination for opencode-web over loopback + LAN + nebula.
# Host publishing lives in docker-compose.yml (caddy `ports:`); Caddy itself
# listens on all container interfaces for the configured ports.
#
# Access log (JSON to stdout, one line per fetch): the ONLY record of slow
# fetches. The error log shows failures (502/dial); only the access log
# carries `duration` + `size` per request, which is how a "loading takes
# forever" complaint becomes a number. Logger names are http.log.access.logN
# (one per site block), so match with startswith, not ==. Query the slow ones:
#   docker logs opencode-caddy 2>&1 | python3 -c \
#     'import json,sys
# [print(e["ts"], round(e.get("duration",0),2), e["request"]["method"], e["request"]["uri"][:70], e.get("status",0)) for l in sys.stdin for e in [json.loads(l)] if str(e.get("logger","")).startswith("http.log.access") and e.get("duration",0)>5]'
# (Caddy access logs go to stderr of the container; `duration` is seconds.)

:4096 {
	tls /certs/opencode.crt /certs/opencode.key
	log {
		output stdout
		format json
	}
	# Static assets: content-hashed filenames (…-Bu_Dc9RP.js) are immutable, so
	# the browser may cache them forever. The access log showed re-fetch storms
	# (/favicon-v3.ico x46, /assets/* x23) and every miss queues behind the
	# single-threaded web server, inflating its measured `duration` into the
	# slow-fetch trip (sentinel T4). Caching at the edge removes the repeats.
	# (Validate before reload: `docker compose ... exec caddy caddy validate
	#  --config /etc/caddy/Caddyfile`; a header directive cannot change routing.)
	@immutable path_regexp hashed `-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|ttf|svg|png|webp)$`
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@icons path /favicon* /apple-touch-icon* /assets/Inter.ttf /assets/sprite-*.svg
	header @icons Cache-Control "public, max-age=86400"
	# /provider was the single dominant slow-fetch (x188 in the access log): the
	# SPA fetches it on every page load, but the model/provider list is stable
	# until the config changes. A short edge TTL collapses the per-load storm
	# without meaningful staleness (query strings are part of the cache key, so
	# /provider?directory=… caches separately). See runbook `slow-fetch`.
	@provider path /provider*
	header @provider Cache-Control "public, max-age=120"
	reverse_proxy opencode-web:4096
}

:5099 {
	tls /certs/opencode.crt /certs/opencode.key
	log {
		output stdout
		format json
	}
	# No caching here: :5099 serves the live observability dashboard (inline
	# HTML + dynamic /api/* JSON); stale responses would be wrong. Only the
	# opencode-web SPA on :4096 has cacheable static assets.
	reverse_proxy opencode-web:5099
}
